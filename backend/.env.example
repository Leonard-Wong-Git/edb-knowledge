# ---------------------------------------------------------------------------
# Backend environment configuration
#
# Copy to `.env` for local dev. On Render, set these in
# Dashboard → your service → Environment (do NOT commit a real .env).
# Variable names below must match EXACTLY what the code reads via
# process.env.* (see backend/src/config/env.ts).
# ---------------------------------------------------------------------------

# OpenAI API key — REQUIRED. Used for query embeddings (text-embedding-3-small)
# and LLM synthesis. The backend throws on startup/first request if missing.
# Get from https://platform.openai.com/api-keys . Placeholder only here.
OPENAI_API_KEY=sk-your_openai_api_key_here

# OpenAI chat model for synthesis. Optional — defaults to "gpt-4.1-nano".
OPENAI_MODEL=gpt-4.1-nano

# HTTP port the server listens on. Optional — defaults to 8787.
# On Render leave UNSET: Render injects its own PORT and the code reads it.
PORT=8787

# Allowed CORS origin for browser requests. Optional.
# Defaults to https://leonard-wong-git.github.io when unset.
# Set to the GitHub Pages origin, or leave UNSET to use the safe default.
# NEVER set this to "*".
CORS_ORIGIN=https://leonard-wong-git.github.io

# Path to the Channel A approved-facts knowledge file (relative to compiled
# dist module location). Optional — defaults to "../../../role_facts.json".
KNOWLEDGE_PATH=../../../role_facts.json

# --- Channel B (Supabase pgvector semantic search) -------------------------
# Both vars below are REQUIRED for Channel B. If EITHER is missing/empty,
# Channel B degrades gracefully: POST /api/search/channel-b returns HTTP 200
# with {"ok":false,"degraded":true,...} and combined search falls back to
# Channel A only. The names must be EXACTLY these strings.

# Supabase Project URL. From Supabase Dashboard → Project Settings →
# Data API (or API) → Project URL. Example shape only below.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public API key. From Supabase Dashboard → Project Settings →
# API Keys → "anon" / "public" key. The code reads SUPABASE_ANON_KEY and
# sends it as both the `apikey` header and a Bearer token to the
# match_wiki_chunks RPC. NOTE: the variable MUST be named SUPABASE_ANON_KEY —
# a key stored under any other name (e.g. SUPABASE_SERVICE_KEY,
# SUPABASE_KEY) will NOT be read and Channel B stays degraded.
SUPABASE_ANON_KEY=your_supabase_anon_or_public_key_here

# --- Channel B incremental-sync endpoints (Q4 Phase 2) ---------------------
# Downstream-scoped read key for GET /api/channel-b/manifest and
# POST /api/channel-b/chunks (see dev/CHANNEL_B_SYNC_SPEC.md). OPTIONAL but
# fail-closed: when UNSET/empty, BOTH endpoints return HTTP 503 {"error":"sync
# disabled"} and serve nothing. Comma-separate multiple values to rotate keys
# (all listed values are accepted during a swap). Generate a strong random
# secret, e.g. `openssl rand -hex 32`. Store the SAME value in the downstream
# consumer's secret store (e.g. GitHub Actions secret). NEVER commit a real key.
CHANNEL_B_SYNC_KEY=
